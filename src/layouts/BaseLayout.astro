---
import '../styles/matcha.min.css';
import '../styles/site.css';

interface Frontmatter {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  canonical?: string;
  eventDialog?: boolean;
  pagefind?: boolean;
  lastVerified?: Date;
}
interface Props { frontmatter: Frontmatter; }

const { frontmatter } = Astro.props;
const { title, description, ogImage, ogImageAlt, canonical, pagefind = true, lastVerified } = frontmatter;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const canonicalUrl = canonical ?? pageUrl;
const branch = process.env.WORKERS_CI_BRANCH;
const isPreview = branch !== undefined && branch !== 'main';
const ogImageAbsolute = ogImage ? new URL(ogImage.src, Astro.site).toString() : new URL('/og-image.svg', Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Graham County Mesh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="theme-color" content="#080608" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <SiteHeader />
    <main {...(pagefind ? { 'data-pagefind-body': '' } : {})}>
      <Nav />
      <slot />
      {lastVerified && <p class="last-verified">Verified <time datetime={lastVerified.toISOString().slice(0, 10)}>{new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(lastVerified)}</time></p>}
      <SiteFooter />
    </main>
  </body>
</html>
